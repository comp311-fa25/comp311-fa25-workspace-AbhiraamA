# RISC-V Machine Code for Complete Tests

# I-type immediate encoding for negative numbers uses two's complement in 12 bits
# -20 in 12-bit two's complement = 0xFEC (111111101100)

# addi x4, x0, -20         : opcode=0010011, rd=00100, funct3=000, rs1=00000, imm=-20 (0xFEC)
# 111111101100_00000_000_00100_0010011 = 0xFEC00213

# addi x5, x4, 0x7F0       : imm=0x7F0 (011111110000)
# 011111110000_00100_000_00101_0010011 = 0x7F020293

# addi x6, x5, 0x701       : imm=0x701
# 011100000001_00101_000_00110_0010011 = 0x70128313

# addi x7, x6, 0x531       : imm=0x531
# 010100110001_00110_000_00111_0010011 = 0x53130393

# andi x14, x6, 0x123      : imm=0x123
# 000100100011_00110_111_01110_0010011 = 0x12337713

# andi x15, x14, 0x71C     : imm=0x71C
# 011100011100_01110_111_01111_0010011 = 0x71C77793

# andi x17, x15, 0x541     : imm=0x541
# 010101000001_01111_111_10001_0010011 = 0x5417F893

# slti x18, x4, 311        : imm=311 (0x137)
# 000100110111_00100_010_10010_0010011 = 0x13722913

# slti x19, x18, 2         : imm=2
# 000000000010_10010_010_10011_0010011 = 0x00292993

# slti x20, x19, 0         : imm=0
# 000000000000_10011_010_10100_0010011 = 0x0009A013

# slti x21, x20, -3        : imm=-3 (0xFFD)
# 111111111101_10100_010_10101_0010011 = 0xFFDA2A93

# slti x22, x21, 5         : imm=5
# 000000000101_10101_010_10110_0010011 = 0x005AAB13

# addi x0, x22, 0          : imm=0
# 000000000000_10110_000_00000_0010011 = 0x000B0013

# slti x23, x4, -20        : imm=-20 (0xFEC)
# 111111101100_00100_010_10111_0010011 = 0xFEC22B93

# addi x0, x23, 0          : imm=0
# 000000000000_10111_000_00000_0010011 = 0x000B8013

# slti x24, x11, -90       : imm=-90 (0xFA6)
# 111110100110_01011_010_11000_0010011 = 0xFA65AC13

# addi x0, x24, 0          : imm=0
# 000000000000_11000_000_00000_0010011 = 0x000C0013

# slti x25, x4, 0          : imm=0
# 000000000000_00100_010_11001_0010011 = 0x00022C93

# addi x0, x25, 0          : imm=0
# 000000000000_11001_000_00000_0010011 = 0x000C8013

# slti x26, x11, 600       : imm=600 (0x258)
# 001001011000_01011_010_11010_0010011 = 0x2585AD13

# addi x0, x26, 0          : imm=0
# 000000000000_11010_000_00000_0010011 = 0x000D0013

# slti x27, x4, -1         : imm=-1 (0xFFF)
# 111111111111_00100_010_11011_0010011 = 0xFFF22D93

# addi x0, x27, 0          : imm=0
# 000000000000_11011_000_00000_0010011 = 0x000D8013

# R-type: funct7_rs2_rs1_funct3_rd_opcode
# add x8, x4, x5           : funct7=0000000, rs2=00101, rs1=00100, funct3=000, rd=01000, opcode=0110011
# 0000000_00101_00100_000_01000_0110011 = 0x00520433

# add x9, x6, x7           : rs2=00111, rs1=00110
# 0000000_00111_00110_000_01001_0110011 = 0x007304B3

# add x10, x8, x9          : rs2=01001, rs1=01000
# 0000000_01001_01000_000_01010_0110011 = 0x00940533

# sub x11, x6, x4          : funct7=0100000, rs2=00100, rs1=00110
# 0100000_00100_00110_000_01011_0110011 = 0x404305B3

# sub x12, x7, x5          : rs2=00101, rs1=00111
# 0100000_00101_00111_000_01100_0110011 = 0x40538633

# sub x13, x10, x8         : rs2=01000, rs1=01010
# 0100000_01000_01010_000_01101_0110011 = 0x408506B3

# or x28, x4, x5           : funct7=0000000, funct3=110, rs2=00101, rs1=00100
# 0000000_00101_00100_110_11100_0110011 = 0x00526E33

# or x29, x6, x14          : rs2=01110, rs1=00110
# 0000000_01110_00110_110_11101_0110011 = 0x00E36EB3

# or x30, x11, x12         : rs2=01100, rs1=01011
# 0000000_01100_01011_110_11110_0110011 = 0x00C5EF33

# and x1, x6, x7           : funct7=0000000, funct3=111, rs2=00111, rs1=00110
# 0000000_00111_00110_111_00001_0110011 = 0x007370B3

# and x2, x10, x11         : rs2=01011, rs1=01010
# 0000000_01011_01010_111_00010_0110011 = 0x00B57133

# and x3, x28, x29         : rs2=11101, rs1=11100
# 0000000_11101_11100_111_00011_0110011 = 0x01DE71B3

# slt x31, x4, x5          : funct7=0000000, funct3=010, rs2=00101, rs1=00100
# 0000000_00101_00100_010_11111_0110011 = 0x00522FB3

# slt x16, x7, x6          : rs2=00110, rs1=00111
# 0000000_00110_00111_010_10000_0110011 = 0x0063A833

# slt x21, x10, x11        : rs2=01011, rs1=01010
# 0000000_01011_01010_010_10101_0110011 = 0x00B52AB3

